# Success IELTS — environment variables
# Copy this file to .env.local and fill in real values. Never commit .env.local.
# This file intentionally contains no real secrets.

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# --- Database (Fase 1) ---
# PostgreSQL connection string for Prisma.
# DATABASE_URL=postgresql://user:password@localhost:5432/success_ielts

# --- Auth (Fase 1) ---
# AUTH_SECRET=
# AUTH_URL=http://localhost:3000
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# --- Redis (optional, for rate limiting / queues) ---
# REDIS_URL=redis://localhost:6379

# --- AI provider for Writing/Speaking feedback (optional, Fase 9-10) ---
# The app must keep working if these are unset.
# AI_PROVIDER=
# AI_API_KEY=

# --- Object storage for audio/recordings (Fase 7, 10) ---
# STORAGE_DRIVER=local
# STORAGE_BUCKET=

# --- Payments (Fase 16) — default OFF until fully configured ---
PAYMENTS_ENABLED=false
# MIDTRANS_SERVER_KEY=
# MIDTRANS_CLIENT_KEY=

# --- Seed admin (Fase 1) ---
# SEED_ADMIN_EMAIL=
# SEED_ADMIN_PASSWORD=
