// Success IELTS — Prisma schema
// Fase 1: auth, RBAC, onboarding.
// Fase 2: content model (CoursePath/Module/Lesson/Topic/Question), CMS review
// workflow. Skill-specific content (Passage/AudioAsset/WritingTask/
// SpeakingPrompt) lands in Fase 7-10 when those labs are built.
// Fase 3: catalog browsing (Bookmark/Note/LessonProgress) and the real
// student lesson page.
// Fase 5: diagnostic test (DiagnosticResult/SkillEstimate/DiagnosticAnswer)
// and study plan generation (StudyPlan/StudyPlanItem).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ---------- Auth & accounts ----------

enum Role {
  STUDENT
  TEACHER
  ADMIN
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  /// Null when the user only ever signs in via an OAuth provider.
  passwordHash  String?
  role          Role      @default(STUDENT)

  accounts            Account[]
  sessions            Session[]
  profile             Profile?
  preference          UserPreference?
  passwordResetTokens PasswordResetToken[]

  reviewedLessons           Lesson[]             @relation("LessonReviewedBy")
  createdQuestions          Question[]           @relation("QuestionCreatedBy")
  reviewedQuestions         Question[]           @relation("QuestionReviewedBy")
  createdListeningPassages  ListeningPassage[]   @relation("ListeningPassageCreatedBy")
  reviewedListeningPassages ListeningPassage[]   @relation("ListeningPassageReviewedBy")
  createdReadingPassages    ReadingPassage[]     @relation("ReadingPassageCreatedBy")
  reviewedReadingPassages   ReadingPassage[]     @relation("ReadingPassageReviewedBy")
  createdWritingTasks       WritingTask[]        @relation("WritingTaskCreatedBy")
  reviewedWritingTasks      WritingTask[]        @relation("WritingTaskReviewedBy")
  writingSubmissions        WritingSubmission[]
  createdSpeakingPrompts    SpeakingPrompt[]     @relation("SpeakingPromptCreatedBy")
  reviewedSpeakingPrompts   SpeakingPrompt[]     @relation("SpeakingPromptReviewedBy")
  speakingSubmissions       SpeakingSubmission[]
  speakingRecordings        SpeakingRecording[]
  createdMockTests          MockTest[]           @relation("MockTestCreatedBy")
  reviewedMockTests         MockTest[]           @relation("MockTestReviewedBy")
  attempts                  Attempt[]
  bookmarks                 Bookmark[]
  notes                     Note[]
  lessonProgress            LessonProgress[]
  diagnosticResults         DiagnosticResult[]
  studyPlans                StudyPlan[]
  questionAttempts          QuestionAttempt[]
  mistakeBookEntries        MistakeBookEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

/// Auth.js adapter model — do not rename fields, the PrismaAdapter depends on this shape.
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

/// Auth.js adapter model.
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

/// Auth.js adapter model — used for email verification tokens.
model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

/// Custom (not an Auth.js adapter model) — powers the "forgot password" flow.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

// ---------- Onboarding ----------

enum TestType {
  ACADEMIC
  GENERAL_TRAINING
  UNDECIDED
}

enum LearningGoal {
  STUDY_SCHOLARSHIP
  WORK
  MIGRATION
  PERSONAL_DEVELOPMENT
}

enum SkillName {
  LISTENING
  READING
  WRITING
  SPEAKING
}

enum DailyStudyMinutes {
  TEN
  TWENTY
  THIRTY
  FORTY_FIVE
  SIXTY_PLUS
}

enum InterfaceLanguage {
  ID
  EN
}

/// Learning goals captured at onboarding. One-to-one with User; recomputed
/// (not deleted) when the user changes target/date so history isn't lost —
/// see docs/DECISIONS.md.
model Profile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  goal                LearningGoal?
  testType            TestType?
  targetOverallBand   Float?
  targetListeningBand Float?
  targetReadingBand   Float?
  targetWritingBand   Float?
  targetSpeakingBand  Float?
  testDate            DateTime?
  hardestSkill        SkillName?

  onboardingCompletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("profiles")
}

model UserPreference {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  dailyStudyMinutes DailyStudyMinutes @default(TWENTY)
  timezone          String            @default("Asia/Jakarta")
  interfaceLanguage InterfaceLanguage @default(ID)
  reminderEnabled   Boolean           @default(false)
  /// 24h "HH:mm", local to `timezone`.
  reminderTime      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("user_preferences")
}

// ---------- Content / curriculum (Fase 2) ----------

/// draft -> in_review -> approved -> published; archived instead of deleted
/// so attempt history referencing a question/lesson never dangles.
enum ContentStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  PUBLISHED
  ARCHIVED
}

/// Broader than `SkillName` (onboarding's four IELTS test skills): content
/// also covers Grammar/Vocabulary/Pronunciation/Test Strategy per Master
/// Prompt §6, which are not IELTS sections themselves but are taught as part
/// of the curriculum.
enum SkillArea {
  LISTENING
  READING
  WRITING
  SPEAKING
  GRAMMAR
  VOCABULARY
  PRONUNCIATION
  TEST_STRATEGY
}

/// Pedagogical language level (Master Prompt §6) — distinct from IELTS band;
/// never presented to users as an official CEFR<->band conversion.
enum PedagogicalLevel {
  STARTER
  A1
  A2
  B1
  B2
  C1_ENRICHMENT
}

enum QuestionType {
  MULTIPLE_CHOICE
  GAP_FILL
  MATCHING
  ORDERING
  SHORT_ANSWER
  TRUE_FALSE_NOT_GIVEN
  YES_NO_NOT_GIVEN
  SENTENCE_TRANSFORMATION
  ERROR_CORRECTION
  SUMMARY_COMPLETION
}

/// Free-form tag spanning Lessons and Questions (e.g. "environment",
/// "present-perfect") — orthogonal to the CoursePath > Module > Lesson
/// sequencing, used for cross-cutting catalog/search filtering.
model Topic {
  id    String     @id @default(cuid())
  code  String     @unique
  name  String
  skill SkillArea?

  lessons   LessonTopic[]
  questions QuestionTopic[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("topics")
}

model CoursePath {
  id          String  @id @default(cuid())
  code        String  @unique
  title       String
  description String?
  order       Int

  modules Module[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("course_paths")
}

model Module {
  id           String     @id @default(cuid())
  code         String     @unique
  coursePathId String
  coursePath   CoursePath @relation(fields: [coursePathId], references: [id], onDelete: Cascade)

  title       String
  description String?
  level       PedagogicalLevel
  skill       SkillArea
  order       Int

  lessons Lesson[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([coursePathId])
  @@map("modules")
}

/// `content` holds the structured lesson body (explanation, examples, common
/// mistakes, guided/independent practice, summary, checklist, references —
/// see lib/content/schema.ts for the validated shape) as JSON rather than a
/// fully normalized set of tables: the per-lesson shape varies enough by
/// skill that forcing one rigid relational structure would mean constant
/// migrations, while every field that other features must query (status,
/// level, skill, order, prerequisites) stays a real column.
model Lesson {
  id       String @id @default(cuid())
  code     String @unique
  moduleId String
  module   Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  title            String
  level            PedagogicalLevel
  skill            SkillArea
  targetBandRange  String?
  estimatedMinutes Int
  order            Int

  objectives Json
  content    Json

  topics         LessonTopic[]
  requires       LessonPrerequisite[] @relation("LessonRequires")
  requiredFor    LessonPrerequisite[] @relation("LessonRequiredFor")
  questions      Question[]
  bookmarks      Bookmark[]
  notes          Note[]
  progress       LessonProgress[]
  studyPlanItems StudyPlanItem[]

  contentVersion Int           @default(1)
  reviewStatus   ContentStatus @default(DRAFT)
  reviewedById   String?
  reviewedBy     User?         @relation("LessonReviewedBy", fields: [reviewedById], references: [id])
  reviewedAt     DateTime?
  sourceNotes    String?

  createdAt     DateTime @default(now())
  lastUpdatedAt DateTime @updatedAt

  @@index([moduleId])
  @@index([reviewStatus])
  @@map("lessons")
}

model LessonPrerequisite {
  id                   String @id @default(cuid())
  lessonId             String
  lesson               Lesson @relation("LessonRequires", fields: [lessonId], references: [id], onDelete: Cascade)
  prerequisiteLessonId String
  prerequisiteLesson   Lesson @relation("LessonRequiredFor", fields: [prerequisiteLessonId], references: [id], onDelete: Cascade)

  @@unique([lessonId, prerequisiteLessonId])
  @@map("lesson_prerequisites")
}

model LessonTopic {
  lessonId String
  lesson   Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  topicId  String
  topic    Topic  @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@id([lessonId, topicId])
  @@map("lesson_topics")
}

/// Generic question model covering the practice-engine item types used by
/// Grammar/Vocabulary/Listening/Reading mini-quizzes (Fase 6). Writing/
/// Speaking tasks are free-response and get their own models in Fase 9-10
/// rather than being forced through `options`/`answerKey`.
model Question {
  id                 String            @id @default(cuid())
  code               String            @unique
  lessonId           String?
  lesson             Lesson?           @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  listeningPassageId String?
  listeningPassage   ListeningPassage? @relation(fields: [listeningPassageId], references: [id], onDelete: SetNull)
  readingPassageId   String?
  readingPassage     ReadingPassage?   @relation(fields: [readingPassageId], references: [id], onDelete: SetNull)

  type            QuestionType
  skill           SkillArea
  level           PedagogicalLevel
  targetBandRange String?
  difficulty      Int              @default(3)

  /// { text, instructions?, context? } — structure left to the renderer per
  /// `type` rather than forcing every question type into one shape.
  prompt          Json
  /// Choice-based types only (e.g. multiple choice): [{ id, text }].
  options         Json?
  /// Canonical correct answer(s); shape depends on `type`.
  answerKey       Json
  /// Additional strings/values accepted as correct besides `answerKey`.
  acceptedAnswers Json?
  explanation     String
  /// Reading Lab evidence-based review (Master Prompt §8.6: "Ulasan
  /// pasca-tes mencantumkan bukti dari passage") — a short excerpt/paragraph
  /// reference, e.g. "Paragraf C: '...'". Nullable since only Reading
  /// questions currently populate it.
  evidence        String?
  /// Soft word-limit hint for free-text answers (e.g. "NO MORE THAN TWO
  /// WORDS"), shown in the UI, not enforced as a hard submit block.
  wordLimit       Int?

  topics             QuestionTopic[]
  diagnosticAnswers  DiagnosticAnswer[]
  attempts           QuestionAttempt[]
  mistakeBookEntries MistakeBookEntry[]
  attemptAnswers     AttemptAnswer[]

  estimatedSeconds Int?

  contentVersion Int           @default(1)
  reviewStatus   ContentStatus @default(DRAFT)
  sourceType     String        @default("original")
  createdById    String?
  createdBy      User?         @relation("QuestionCreatedBy", fields: [createdById], references: [id])
  reviewedById   String?
  reviewedBy     User?         @relation("QuestionReviewedBy", fields: [reviewedById], references: [id])

  createdAt     DateTime @default(now())
  lastUpdatedAt DateTime @updatedAt

  @@index([lessonId])
  @@index([listeningPassageId])
  @@index([readingPassageId])
  @@index([reviewStatus])
  @@map("questions")
}

model QuestionTopic {
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  topicId    String
  topic      Topic    @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@id([questionId, topicId])
  @@map("question_topics")
}

// ---------- Catalog browsing (Fase 3) ----------

enum LessonProgressStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

model Bookmark {
  id       String @id @default(cuid())
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId String
  lesson   Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, lessonId])
  @@map("bookmarks")
}

/// One freeform note per user per lesson (not a list of notes) — kept to one
/// row so "my notes for this lesson" has an obvious, simple UI: a single
/// textarea, not a thread.
model Note {
  id       String @id @default(cuid())
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId String
  lesson   Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  body String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, lessonId])
  @@map("notes")
}

model LessonProgress {
  id       String @id @default(cuid())
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId String
  lesson   Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  status      LessonProgressStatus @default(NOT_STARTED)
  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, lessonId])
  @@map("lesson_progress")
}

// ---------- Diagnostic test & study plan (Fase 5) ----------

enum DiagnosticStatus {
  IN_PROGRESS
  COMPLETED
}

/// A diagnostic ATTEMPT, separate from any IELTS mock test (Master Prompt
/// §8.1: "Pisahkan diagnostic grammar dari IELTS mock test" — this model is
/// never used to back a Fase 11 tryout attempt).
model DiagnosticResult {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  status DiagnosticStatus @default(IN_PROGRESS)

  /// Null until completed. Deliberately constrained to levels the current
  /// question bank can actually distinguish between — see
  /// lib/diagnostic/estimate.ts and docs/DECISIONS.md.
  estimatedLevel PedagogicalLevel?
  /// 0-1. Low by design while the question bank is small — never implies
  /// false precision (Master Prompt §3, §9).
  confidence     Float?

  answers        DiagnosticAnswer[]
  skillEstimates SkillEstimate[]
  studyPlans     StudyPlan[]

  startedAt   DateTime  @default(now())
  completedAt DateTime?

  @@index([userId])
  @@map("diagnostic_results")
}

model SkillEstimate {
  id                 String           @id @default(cuid())
  diagnosticResultId String
  diagnosticResult   DiagnosticResult @relation(fields: [diagnosticResultId], references: [id], onDelete: Cascade)

  skill        SkillArea
  correctCount Int
  totalCount   Int
  scorePercent Float

  @@unique([diagnosticResultId, skill])
  @@map("skill_estimates")
}

model DiagnosticAnswer {
  id                 String           @id @default(cuid())
  diagnosticResultId String
  diagnosticResult   DiagnosticResult @relation(fields: [diagnosticResultId], references: [id], onDelete: Cascade)
  questionId         String
  question           Question         @relation(fields: [questionId], references: [id], onDelete: Cascade)

  submitted Json
  correct   Boolean

  createdAt DateTime @default(now())

  @@unique([diagnosticResultId, questionId])
  @@map("diagnostic_answers")
}

enum StudyPlanItemStatus {
  PENDING
  DONE
  SKIPPED
}

/// Regenerating a plan marks the old one `isActive: false` instead of
/// deleting it, so history survives target/date changes (Master Prompt
/// §8.2: "sistem menghitung ulang rencana tanpa menghapus histori").
model StudyPlan {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  isActive          Boolean           @default(true)
  targetOverallBand Float?
  testDate          DateTime?
  dailyStudyMinutes DailyStudyMinutes

  generatedFromDiagnosticId String?
  generatedFromDiagnostic   DiagnosticResult? @relation(fields: [generatedFromDiagnosticId], references: [id], onDelete: SetNull)

  items StudyPlanItem[]

  createdAt DateTime @default(now())

  @@index([userId, isActive])
  @@map("study_plans")
}

model StudyPlanItem {
  id          String    @id @default(cuid())
  studyPlanId String
  studyPlan   StudyPlan @relation(fields: [studyPlanId], references: [id], onDelete: Cascade)
  lessonId    String
  lesson      Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  order         Int
  scheduledDate DateTime
  status        StudyPlanItemStatus @default(PENDING)
  /// Short human-readable rationale shown in the UI, e.g. "Prioritas:
  /// kelemahan di Grammar" — not a foreign key, just an explanation string.
  reason        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([studyPlanId])
  @@map("study_plan_items")
}

// ---------- Practice engine & Buku Kesalahan (Fase 6) ----------

enum AttemptSource {
  ADAPTIVE_PRACTICE
  MISTAKE_REVIEW
  LISTENING_PRACTICE
  READING_PRACTICE
  TRYOUT
}

/// Master Prompt §8.10: "Pengguna bisa menandai alasan error" — a fixed set
/// rather than freeform text so the "kesalahan berulang" dashboard/report
/// can aggregate by reason without NLP.
enum ErrorReason {
  VOCAB_UNKNOWN
  MISUNDERSTOOD_INSTRUCTION
  MISSED_DETAIL
  GRAMMAR
  WRONG_STRATEGY
  RUSHED
  TYPO
}

/// One row per answer submitted in the adaptive practice engine or a
/// mistake-book review — the source of truth for "simpan waktu menjawab,
/// percobaan dan riwayat" (Master Prompt §8.4). Deliberately separate from
/// `DiagnosticAnswer` (one-time placement test) and the Fase 3 lesson
/// mini-quiz (which is check-as-you-go and not attempt-tracked) — merging
/// all three into one table would couple unrelated review workflows.
model QuestionAttempt {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  source      AttemptSource
  submitted   Json
  correct     Boolean
  timeSpentMs Int

  attemptedAt DateTime @default(now())

  @@index([userId, questionId])
  @@index([userId, attemptedAt])
  @@map("question_attempts")
}

/// SM-2 review state for one (user, question) pair. Created the first time
/// a user misses a question in adaptive practice; graduates through longer
/// `intervalDays` as reviews succeed. See lib/srs/sm2.ts and
/// docs/DECISIONS.md for why SM-2 (not FSRS) was chosen.
model MistakeBookEntry {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  lastSubmittedAnswer Json
  errorReason         ErrorReason?

  intervalDays Int   @default(1)
  easeFactor   Float @default(2.5)
  repetitions  Int   @default(0)
  reviewCount  Int   @default(0)

  nextReviewAt   DateTime  @default(now())
  firstMissedAt  DateTime  @default(now())
  lastReviewedAt DateTime?

  @@unique([userId, questionId])
  @@index([userId, nextReviewAt])
  @@map("mistake_book_entries")
}

// ---------- Listening Lab (Fase 7) ----------

enum ListeningSection {
  SECTION_1
  SECTION_2
  SECTION_3
  SECTION_4
}

/// One audio passage with its questions. `script` doubles as both the
/// original TTS production script AND the transcript revealed to students
/// after they check their answers (Master Prompt §8.5) — stored as
/// structured turns `[{ speaker, text }]` rather than a flat string so the
/// player can render speaker labels.
model ListeningPassage {
  id         String           @id @default(cuid())
  code       String           @unique
  title      String
  section    ListeningSection
  level      PedagogicalLevel
  /// Free-text accent tag (e.g. "British", "Australian") per §8.5's
  /// "accent/difficulty tags" — not an enum since IELTS doesn't standardize
  /// this list and new accents may be added without a migration.
  accent     String
  difficulty Int              @default(3)

  /// Path under /public, e.g. "/audio/listening/starter-l-001.wav".
  audioUrl        String
  durationSeconds Int
  script          Json
  sourceNotes     String?

  questions        Question[]
  mockTestSections MockTestSection[]

  contentVersion Int           @default(1)
  reviewStatus   ContentStatus @default(DRAFT)
  sourceType     String        @default("original")
  createdById    String?
  createdBy      User?         @relation("ListeningPassageCreatedBy", fields: [createdById], references: [id])
  reviewedById   String?
  reviewedBy     User?         @relation("ListeningPassageReviewedBy", fields: [reviewedById], references: [id])
  reviewedAt     DateTime?

  createdAt     DateTime @default(now())
  lastUpdatedAt DateTime @updatedAt

  @@index([reviewStatus])
  @@map("listening_passages")
}

// ---------- Reading Lab (Fase 8) ----------

enum ReadingExamType {
  ACADEMIC
  GENERAL_TRAINING
}

/// One reading passage with its questions. `paragraphs` is structured
/// (rather than one flat text blob) so the UI's paragraph navigator and
/// "matching information" style questions ("which paragraph mentions...")
/// both have a stable, labelled unit to reference.
model ReadingPassage {
  id       String           @id @default(cuid())
  code     String           @unique
  title    String
  examType ReadingExamType
  level    PedagogicalLevel
  topic    String

  /// [{ label: "A", text: "..." }, ...]
  paragraphs Json
  wordCount  Int

  questions        Question[]
  mockTestSections MockTestSection[]

  contentVersion Int           @default(1)
  reviewStatus   ContentStatus @default(DRAFT)
  sourceType     String        @default("original")
  sourceNotes    String?
  createdById    String?
  createdBy      User?         @relation("ReadingPassageCreatedBy", fields: [createdById], references: [id])
  reviewedById   String?
  reviewedBy     User?         @relation("ReadingPassageReviewedBy", fields: [reviewedById], references: [id])
  reviewedAt     DateTime?

  createdAt     DateTime @default(now())
  lastUpdatedAt DateTime @updatedAt

  @@index([reviewStatus])
  @@map("reading_passages")
}

// ---------- Writing Lab (Fase 9) ----------

enum WritingTaskType {
  TASK1_ACADEMIC
  TASK1_GENERAL_TRAINING
  TASK2
}

enum WritingSubmissionStatus {
  DRAFT
  SUBMITTED
}

/// `sampleAnswer` and `checklistItems` are never sent to the client before
/// a submission reaches SUBMITTED status (same D-021 principle as answer
/// keys) — see WritingLabActions.
model WritingTask {
  id       String           @id @default(cuid())
  code     String           @unique
  title    String
  taskType WritingTaskType
  level    PedagogicalLevel

  prompt     String
  /// Structured data for TASK1_ACADEMIC only, e.g.
  /// { type: "table", headers: [...], rows: [[...]] }. Null for Task 1 GT
  /// (letter scenario) and Task 2 (essay prompt), which need no visual.
  visualData Json?

  minWords         Int
  suggestedMinutes Int

  /// Original sample answer, revealed only after the student submits.
  sampleAnswer   String
  /// Self-assessment prompts covering the four IELTS writing criteria
  /// (Task Response/Achievement, Coherence & Cohesion, Lexical Resource,
  /// Grammatical Range & Accuracy) — own wording, not copied rubric text.
  /// Self-reflection only; never turned into a derived score.
  checklistItems Json

  submissions WritingSubmission[]

  contentVersion Int           @default(1)
  reviewStatus   ContentStatus @default(DRAFT)
  sourceType     String        @default("original")
  sourceNotes    String?
  createdById    String?
  createdBy      User?         @relation("WritingTaskCreatedBy", fields: [createdById], references: [id])
  reviewedById   String?
  reviewedBy     User?         @relation("WritingTaskReviewedBy", fields: [reviewedById], references: [id])
  reviewedAt     DateTime?

  createdAt     DateTime @default(now())
  lastUpdatedAt DateTime @updatedAt

  @@index([reviewStatus])
  @@map("writing_tasks")
}

/// One attempt at a WritingTask. A new row is created each time a student
/// starts the task (rather than resuming one shared draft forever) so past
/// attempts stay visible as real history once SUBMITTED.
model WritingSubmission {
  id            String      @id @default(cuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  writingTaskId String
  writingTask   WritingTask @relation(fields: [writingTaskId], references: [id], onDelete: Cascade)

  outline      String @default("")
  body         String @default("")
  wordCount    Int    @default(0)
  /// [{ body, wordCount, savedAt }], most recent first — autosave history.
  draftHistory Json   @default("[]")

  status         WritingSubmissionStatus @default(DRAFT)
  /// { taskResponse: bool, coherence: bool, lexical: bool, grammar: bool }
  selfAssessment Json?

  submittedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([userId, writingTaskId])
  @@map("writing_submissions")
}

enum SpeakingPart {
  PART1
  PART2
  PART3
}

enum SpeakingSubmissionStatus {
  IN_PROGRESS
  COMPLETED
}

/// One recording per submission (not per question within a part) — keeps
/// the capture pipeline to a single MediaRecorder session regardless of
/// how many follow-up questions a part asks (D-037).
model SpeakingPrompt {
  id    String           @id @default(cuid())
  code  String           @unique
  title String
  part  SpeakingPart
  level PedagogicalLevel
  topic String

  promptText        String
  /// PART2 cue card bullet points only; null for PART1/PART3.
  cueCardPoints     Json?
  /// PART1's set of familiar-topic questions, or PART3's discussion
  /// follow-ups — asked in sequence within the same single recording.
  followUpQuestions Json   @default("[]")

  prepSeconds     Int
  responseSeconds Int

  /// Original model answer text, revealed only after the student
  /// completes their attempt (same D-021/D-034/D-035 reveal-after-submit
  /// principle as every other lab).
  modelAnswer    String
  /// Self-assessment prompts covering fluency/coherence, lexical
  /// resource, grammatical range/accuracy, and pronunciation —
  /// self-reflection only, never a derived score.
  checklistItems Json

  submissions SpeakingSubmission[]

  contentVersion Int           @default(1)
  reviewStatus   ContentStatus @default(DRAFT)
  sourceType     String        @default("original")
  sourceNotes    String?
  createdById    String?
  createdBy      User?         @relation("SpeakingPromptCreatedBy", fields: [createdById], references: [id])
  reviewedById   String?
  reviewedBy     User?         @relation("SpeakingPromptReviewedBy", fields: [reviewedById], references: [id])
  reviewedAt     DateTime?

  createdAt     DateTime @default(now())
  lastUpdatedAt DateTime @updatedAt

  @@index([reviewStatus])
  @@map("speaking_prompts")
}

/// The audio artifact itself, stored on local disk under a server-only
/// directory (never public/) and served only via an ownership-checked
/// route handler — "Lindungi file rekaman" (Master Prompt §8.8). Split out
/// from SpeakingSubmission so deleting a recording (explicit user control,
/// §8.8 "kontrol penghapusan") doesn't have to delete the submission's
/// self-assessment/completion state along with it.
model SpeakingRecording {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  storageKey      String
  mimeType        String
  durationSeconds Int
  sizeBytes       Int
  createdAt       DateTime @default(now())

  submission SpeakingSubmission?

  @@map("speaking_recordings")
}

/// One attempt at a SpeakingPrompt, same "new row per attempt" rationale
/// as WritingSubmission.
model SpeakingSubmission {
  id               String         @id @default(cuid())
  userId           String
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  speakingPromptId String
  speakingPrompt   SpeakingPrompt @relation(fields: [speakingPromptId], references: [id], onDelete: Cascade)

  recordingId String?            @unique
  recording   SpeakingRecording? @relation(fields: [recordingId], references: [id], onDelete: SetNull)

  /// Used when the user declines microphone access, has no input device,
  /// or deletes their recording — recording is opt-in, never required to
  /// complete an attempt (Master Prompt §8.8 "rekaman bersifat opt-in").
  fallbackText String?

  status         SpeakingSubmissionStatus @default(IN_PROGRESS)
  /// { fluency: bool, lexical: bool, grammar: bool, pronunciation: bool }
  selfAssessment Json?

  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([userId, speakingPromptId])
  @@map("speaking_submissions")
}

// ---------- Tryout / exam mode (Fase 11) ----------

/// Never hardcoded as a constant in app logic — `rawToBand()`
/// (lib/scoring/raw-to-band.ts) always reads the active row set from
/// here, per Master Prompt §8.9/§13. IELTS does not publish one single
/// universal official raw-to-band table (the mapping can vary slightly
/// per test version), so this is seeded from a cited, dated third-party
/// reference and is always presented as an estimate — see docs/SCORING.md.
model BandConversionTable {
  id         String          @id @default(cuid())
  examType   ReadingExamType
  /// LISTENING or READING only — Writing/Speaking are not raw-scored.
  section    SkillArea
  minRaw     Int
  maxRaw     Int
  band       Float
  sourceUrl  String
  verifiedAt DateTime
  notes      String?
  active     Boolean         @default(true)

  createdAt DateTime @default(now())

  @@index([examType, section, active])
  @@map("band_conversion_table")
}

enum TestKind {
  SECTION_TEST
  MINI_MOCK
  FULL_MOCK
}

/// Timing/structure rules for a tryout. The admin authoring UI for
/// building new blueprints from scratch ("test builder") is Fase 13 —
/// this phase seeds blueprints via content scripts, the same pattern as
/// every other content type until then.
model TestBlueprint {
  id           String          @id @default(cuid())
  code         String          @unique
  title        String
  examType     ReadingExamType
  kind         TestKind
  /// Primary skill this blueprint raw-scores. Mixed-skill FULL_MOCK
  /// blueprints are schema-compatible but not built this phase — every
  /// MockTest seeded so far is single-skill (D-038).
  skill        SkillArea
  description  String
  /// One continuous timer across every section, matching the real IELTS
  /// Listening/Reading format (no per-section stop/restart).
  totalSeconds Int

  mockTests MockTest[]

  createdAt     DateTime @default(now())
  lastUpdatedAt DateTime @updatedAt

  @@map("test_blueprints")
}

model MockTest {
  id          String        @id @default(cuid())
  code        String        @unique
  title       String
  blueprintId String
  blueprint   TestBlueprint @relation(fields: [blueprintId], references: [id], onDelete: Cascade)

  sections MockTestSection[]
  attempts Attempt[]

  contentVersion Int           @default(1)
  reviewStatus   ContentStatus @default(DRAFT)
  sourceType     String        @default("original")
  sourceNotes    String?
  createdById    String?
  createdBy      User?         @relation("MockTestCreatedBy", fields: [createdById], references: [id])
  reviewedById   String?
  reviewedBy     User?         @relation("MockTestReviewedBy", fields: [reviewedById], references: [id])
  reviewedAt     DateTime?

  createdAt     DateTime @default(now())
  lastUpdatedAt DateTime @updatedAt

  @@index([reviewStatus])
  @@map("mock_tests")
}

/// One passage per section — a whole ListeningPassage/ReadingPassage
/// (with its own Question rows) becomes one section, same granularity as
/// the real test ("Section 1-4" / "Passage 1-3").
model MockTestSection {
  id         String   @id @default(cuid())
  mockTestId String
  mockTest   MockTest @relation(fields: [mockTestId], references: [id], onDelete: Cascade)
  order      Int

  listeningPassageId String?
  listeningPassage   ListeningPassage? @relation(fields: [listeningPassageId], references: [id])
  readingPassageId   String?
  readingPassage     ReadingPassage?   @relation(fields: [readingPassageId], references: [id])

  @@unique([mockTestId, order])
  @@map("mock_test_sections")
}

enum AttemptStatus {
  IN_PROGRESS
  SUBMITTED
  AUTO_SUBMITTED
}

/// One user's run through a MockTest. `deadlineAt` is computed once at
/// creation (startedAt + blueprint.totalSeconds) and is the sole
/// server-side authority for auto-submit — a client-reported elapsed time
/// is never trusted, since that's exactly the kind of value a client
/// clock or network pause/resume can drift or be made to lie about.
model Attempt {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  mockTestId String
  mockTest   MockTest @relation(fields: [mockTestId], references: [id], onDelete: Cascade)

  status      AttemptStatus @default(IN_PROGRESS)
  startedAt   DateTime      @default(now())
  deadlineAt  DateTime
  submittedAt DateTime?

  /// string[] of Question.code currently flagged for review.
  flaggedQuestionCodes Json @default("[]")

  /// { rawScore, maxRawScore, band, accuracyByType, timeUsedSeconds,
  /// weakTopics } — set once at submit time (manual or auto); null while
  /// IN_PROGRESS.
  result Json?

  answers AttemptAnswer[]
  events  AttemptEvent[]

  @@index([userId, mockTestId])
  @@map("attempts")
}

model AttemptAnswer {
  id         String   @id @default(cuid())
  attemptId  String
  attempt    Attempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  /// string | string[], same submitted-value shape used elsewhere
  /// (toSubmittedValue()).
  value   Json
  correct Boolean?

  updatedAt DateTime @updatedAt

  @@unique([attemptId, questionId])
  @@map("attempt_answers")
}

/// A lightweight audit trail ("started", "resumed", "flagged",
/// "unflagged", "submitted", "auto_submitted") — supports "resume setelah
/// koneksi terputus" by giving the client something to reconcile against,
/// and is a cheap place to notice anomalies later without needing it for
/// MVP correctness.
model AttemptEvent {
  id        String   @id @default(cuid())
  attemptId String
  attempt   Attempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  type      String
  createdAt DateTime @default(now())

  @@map("attempt_events")
}
