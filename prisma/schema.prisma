// Success IELTS — Prisma schema
// Fase 1: auth, RBAC, onboarding. Content/curriculum models land in Fase 2+.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ---------- Auth & accounts ----------

enum Role {
  STUDENT
  TEACHER
  ADMIN
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  /// Null when the user only ever signs in via an OAuth provider.
  passwordHash  String?
  role          Role      @default(STUDENT)

  accounts            Account[]
  sessions            Session[]
  profile             Profile?
  preference          UserPreference?
  passwordResetTokens PasswordResetToken[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

/// Auth.js adapter model — do not rename fields, the PrismaAdapter depends on this shape.
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

/// Auth.js adapter model.
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

/// Auth.js adapter model — used for email verification tokens.
model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

/// Custom (not an Auth.js adapter model) — powers the "forgot password" flow.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

// ---------- Onboarding ----------

enum TestType {
  ACADEMIC
  GENERAL_TRAINING
  UNDECIDED
}

enum LearningGoal {
  STUDY_SCHOLARSHIP
  WORK
  MIGRATION
  PERSONAL_DEVELOPMENT
}

enum SkillName {
  LISTENING
  READING
  WRITING
  SPEAKING
}

enum DailyStudyMinutes {
  TEN
  TWENTY
  THIRTY
  FORTY_FIVE
  SIXTY_PLUS
}

enum InterfaceLanguage {
  ID
  EN
}

/// Learning goals captured at onboarding. One-to-one with User; recomputed
/// (not deleted) when the user changes target/date so history isn't lost —
/// see docs/DECISIONS.md.
model Profile {
  id      String @id @default(cuid())
  userId  String @unique
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  goal                LearningGoal?
  testType            TestType?
  targetOverallBand   Float?
  targetListeningBand Float?
  targetReadingBand   Float?
  targetWritingBand   Float?
  targetSpeakingBand  Float?
  testDate            DateTime?
  hardestSkill        SkillName?

  onboardingCompletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("profiles")
}

model UserPreference {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  dailyStudyMinutes DailyStudyMinutes @default(TWENTY)
  timezone          String            @default("Asia/Jakarta")
  interfaceLanguage InterfaceLanguage @default(ID)
  reminderEnabled   Boolean           @default(false)
  /// 24h "HH:mm", local to `timezone`.
  reminderTime      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("user_preferences")
}
